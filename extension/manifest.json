{
  "manifest_version": 3,
  "name": "Omnigroup",
  "version": "0.1.0",
  "description": "Discutez avec votre démon Omniscient local, avec la page en cours comme contexte (site par site, sur accord).",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "32": "icons/32x32.png",
    "128": "icons/128x128.png"
  },
  "action": {
    "default_title": "Omnigroup",
    "default_icon": {
      "32": "icons/32x32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
