{
  "manifest_version": 3,
  "name": "Omnigroup",
  "version": "0.3.0",
  "description": "Montre au widget Omnigroup la page que vous regardez, pour qu'il puisse la joindre à vos questions (décochez pour la garder pour vous).",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "32": "icons/32x32.png",
    "128": "icons/128x128.png"
  },
  "action": {
    "default_title": "Omnigroup",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/32x32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "capture-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "watch.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
